# Frontend (Vite) config — safe to expose client-side, because Supabase
# Row-Level Security (not key secrecy) is what protects tenant data.
#
# Local dev: values from `npx supabase status -o env` -> API_URL / ANON_KEY.
# Production: from the Supabase Dashboard -> Project Settings -> API ->
#   "Project URL" and the "anon" / "public" key (NOT "service_role").
# Copy this file to .env.local and fill in the values (gitignored).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
